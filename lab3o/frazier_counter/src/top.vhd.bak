-------------------------------------------------------------------------------
--Violet Frazier
-- counter thing
-------------------------------------------------------------------------------
library ieee;
use ieee.std_logic_1164.all;

entity top is
  port (
    clk             : in  std_logic; 
    reset           : in  std_logic;
    output          : out std_logic_vector(6 downto 0);
  );
end top;

architecture beh of top is

compoent frazier_counter is
  port(
      clk           :IN std_logic;
     reset         :IN std_logic;
     binary_input  :IN std_logic_vector(3 downto 0);
     HEX0          :OUT std_logic_vector(6 downto 0)
        );
end component;

component generic_adder_beh is 
  port(
    a       : in  std_logic_vector(bits-1 downto 0);
    b       : in  std_logic_vector(bits-1 downto 0);
    cin     : in  std_logic;
    sum     : out std_logic_vector(bits-1 downto 0);
    cout    : out std_logic
  );
end component;

componenet generic_counter is 
  port(
    clk             : in  std_logic; 
    reset           : in  std_logic;
    output          : out std_logic
  );
end componenet;

constant bits : integer := 4;
signal enable : std_logic;
signal sum    : std_logic_vector(bits-1 downto 0);
signal sum_sig   : std_logic_vector(bits-1 downto 0);

begin
uut: frazier_counter
  port map(
     clk           => ckl,
     reset         => reset,
     binary_input  => sum,
     HEX0          => output
  );
  
uut: generic_adder_beh 
  port(
    a       => sum_sig,
    b       =>  "0000"
    cin     => '0',
    sum     => sum,
    cout    => open
  );

uut: generic_counter 
  port(
    clk       => clk,
    reset     => reset,
    output    => enable
    );
end beh;

